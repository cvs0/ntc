#version 450
layout(local_size_x = 64) in;
layout(std430, set = 0, binding = 0) buffer Param { float param[]; };
layout(std430, set = 0, binding = 1) buffer Grad { float grad[]; };
layout(std430, set = 0, binding = 2) buffer Moment { float moment[]; };
layout(std430, set = 0, binding = 3) buffer Second { float second[]; };
layout(push_constant) uniform Step {
    float lr;
    float beta1;
    float beta2;
    float eps;
    uint n;
    uint step;
} pc;

void main() {
    uint i = gl_GlobalInvocationID.x;
    if (i >= pc.n) return;
    float g = grad[i];
    float m = pc.beta1 * moment[i] + (1.0 - pc.beta1) * g;
    float v = pc.beta2 * second[i] + (1.0 - pc.beta2) * g * g;
    moment[i] = m;
    second[i] = v;
    float b1 = 1.0;
    float b2 = 1.0;
    for (uint s = 0u; s < pc.step; ++s) {
        b1 *= pc.beta1;
        b2 *= pc.beta2;
    }
    float mhat = m / (1.0 - b1);
    float vhat = v / (1.0 - b2);
    param[i] = param[i] - pc.lr * mhat / (sqrt(vhat) + pc.eps);
}
