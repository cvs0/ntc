#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_KHR_cooperative_matrix : require
#extension GL_EXT_shader_explicit_arithmetic_types_float16 : require
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_memory_scope_semantics : require
layout(local_size_x = 32, local_size_y = 1, local_size_z = 1) in;
#include "ntc_decode.glsl"

layout(set = 0, binding = 6) buffer Scratch { float16_t scratch[]; };

// 16 pixels per workgroup. First MLP layer is fp16 cooperative-matrix tiles
// of 16x16x16. Later layers use ntc_layer. Every lane calls the coopmat ops.
// The host drops the timing if a native readback does not match ntc_eval.

shared float16_t sA[256];
shared float16_t sB[256];
shared float16_t sC[256];
shared float sFeat[16 * 160];

void main() {
    uint lane = gl_LocalInvocationID.x;
    uint pix0 = gl_WorkGroupID.x * 16u;
    if (lane < 16u && pix0 + lane < g_pc.z * g_pc.w) {
        uint pix = pix0 + lane;
        uint x = pix % g_pc.z;
        uint y = pix / g_pc.z;
        vec2 uv = (vec2(x, y) + vec2(0.5)) / vec2(float(g_pc.z), float(g_pc.w));
        ntc_features(uv, 0);
        for (int k = 0; k < 160; ++k) sFeat[lane * 160 + k] = k < g_nfeat ? g_feat[k] : 0.0;
    }
    barrier();
    uvec4 a0 = g_desc[12u];
    int inn = int(a0.x);
    int out0 = int(a0.y);
    uint woff = a0.z;
    uint soff = g_desc[16u].x;
    uint bits = g_desc[16u].w;
    // Output tiles of 16.
    for (int o0 = 0; o0 < out0; o0 += 16) {
        for (int k0 = 0; k0 < max(inn, 1); k0 += 16) {
            if (lane == 0u) {
                for (int o = 0; o < 16; ++o) {
                    float sc = (o0 + o < out0) ? ntc_f16(soff + uint(o0 + o) * 2u) : 0.0;
                    for (int k = 0; k < 16; ++k) {
                        float w = 0.0;
                        if (o0 + o < out0 && k0 + k < inn) w = ntc_weight(woff, o0 + o, k0 + k, inn, bits) * sc;
                        sA[o * 16 + k] = float16_t(w);
                    }
                }
                for (int p = 0; p < 16; ++p) {
                    for (int k = 0; k < 16; ++k) {
                        float v = 0.0;
                        if (k0 + k < inn) v = sFeat[p * 160 + (k0 + k)];
                        sB[k * 16 + p] = float16_t(v);
                    }
                }
            }
            barrier();
            if (lane == 0u) {
                for (int i = 0; i < 256; ++i) {
                    scratch[i] = sA[i];
                    scratch[256 + i] = sB[i];
                }
            }
            barrier();
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseA> matA;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseB> matB;
            coopmat<float16_t, gl_ScopeSubgroup, 16, 16, gl_MatrixUseAccumulator> matC;
            coopMatLoad(matA, scratch, 0u, 16u, gl_CooperativeMatrixLayoutRowMajor);
            coopMatLoad(matB, scratch, 256u, 16u, gl_CooperativeMatrixLayoutRowMajor);
            matC = coopMatMulAdd(matA, matB, matC);
            coopMatStore(matC, scratch, 512u, 16u, gl_CooperativeMatrixLayoutRowMajor);
            barrier();
            if (lane == 0u) {
                for (int i = 0; i < 256; ++i) sC[i] = scratch[512 + i];
            }
            barrier();
            if (lane < 16u && k0 == 0) {
                for (int o = 0; o < 16 && o0 + o < out0; ++o) g_ha[o0 + o] = 0.0;
            }
            barrier();
            if (lane < 16u) {
                for (int o = 0; o < 16 && o0 + o < out0; ++o) g_ha[o0 + o] += float(sC[o * 16 + int(lane)]);
            }
            barrier();
        }
        if (lane < 16u) {
            for (int o = 0; o < 16 && o0 + o < out0; ++o) {
                g_ha[o0 + o] += ntc_f16(a0.w + uint(o0 + o) * 2u);
                g_ha[o0 + o] = ntc_activate(g_ha[o0 + o], g_desc[1].y, (g_desc[2].x & 2u) != 0u);
            }
        }
        barrier();
    }
    if (lane < 16u && pix0 + lane < g_pc.z * g_pc.w) {
        uint nlayers = g_desc[1].x;
        for (uint li = 1u; li < nlayers; ++li) ntc_layer(li, int(g_desc[12u + li].x));
        if (nlayers == 1u) {
            for (int o = 0; o < out0 && o < 16; ++o) g_y[o] = g_ha[o];
        }
        uint ch = g_desc[0].z;
        uint pix = pix0 + lane;
        uint idx = pix * ch;
        for (uint i = 0u; i < ch; ++i) g_outimg[idx + i] = g_y[i];
    }
}
