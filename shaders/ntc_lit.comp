#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "ntc_decode.glsl"

// Writes float RGB. Directional light on the decoded normal, times albedo.
// Channels are the container order: 0,1,2 albedo and 3,4,5 normal xy z.
void main() {
    uint W = g_pc.z;
    uint H = g_pc.w;
    if (W == 0u || H == 0u) return;
    if (gl_GlobalInvocationID.x >= W || gl_GlobalInvocationID.y >= H) return;
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) / vec2(float(W), float(H));
    ntc_eval(uv, 0);
    vec3 alb = vec3(g_y[0], g_y[1], g_y[2]);
    vec3 nrm = vec3(g_y[3], g_y[4], g_y[5]) * 2.0 - 1.0;
    nrm = normalize(nrm);
    vec3 L = normalize(vec3(0.35, 0.55, 0.76));
    float ndl = clamp(dot(nrm, L), 0.0, 1.0);
    vec3 rgb = alb * (0.15 + 0.85 * ndl);
    uint idx = (gl_GlobalInvocationID.y * W + gl_GlobalInvocationID.x) * 3u;
    g_outimg[idx + 0u] = rgb.r;
    g_outimg[idx + 1u] = rgb.g;
    g_outimg[idx + 2u] = rgb.b;
}
