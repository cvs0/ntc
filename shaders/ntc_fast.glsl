// Full decode at one mip. Read the result with ntcf_y.
void ntcf_eval(vec2 uv, int mip) {
    vec2 u = uv - floor(uv);  // exact for uv in [0, 1); same taps as the integer wrap
    int km = min(mip, 7);
    int n = 0;
    if (0 < NTCF_GRIDS) { ntcf_grid(0, u, km, n, NTCF_LSOFF + n); n += NTCF_GC0; }
    if (1 < NTCF_GRIDS) { ntcf_grid(1, u, km, n, NTCF_LSOFF + n); n += NTCF_GC1; }
    if (2 < NTCF_GRIDS) { ntcf_grid(2, u, km, n, NTCF_LSOFF + n); n += NTCF_GC2; }
    if (3 < NTCF_GRIDS) { ntcf_grid(3, u, km, n, NTCF_LSOFF + n); n += NTCF_GC3; }
    if (4 < NTCF_GRIDS) { ntcf_grid(4, u, km, n, NTCF_LSOFF + n); n += NTCF_GC4; }
    if (5 < NTCF_GRIDS) { ntcf_grid(5, u, km, n, NTCF_LSOFF + n); n += NTCF_GC5; }
    if (6 < NTCF_GRIDS) { ntcf_grid(6, u, km, n, NTCF_LSOFF + n); n += NTCF_GC6; }
    if (7 < NTCF_GRIDS) { ntcf_grid(7, u, km, n, NTCF_LSOFF + n); n += NTCF_GC7; }
    ntcf_pe(uv, mip, n);
    if (0 < NTCF_LAYERS) ntcf_layer0();
    if (1 < NTCF_LAYERS) ntcf_layer1();
    if (2 < NTCF_LAYERS) ntcf_layer2();
    if (3 < NTCF_LAYERS) ntcf_layer3();
}

// Output channel c of the last ntcf_eval, c < NTCF_OUTCH.
float ntcf_y(int c) { return ntcf_ld(c); }
