    const bool uns = !w16 && NTCF_ACTI8 == 0 && NTCF_ACT == 1 && NTCF_REQUANT == 0;
    const int qmax = w16 ? 32767 : uns ? 255 : 127;
    const int qmin = uns ? 0 : -qmax;
    float s;
    if (NTCF_ACTI8 != 0) {
        s = max(ntcf_pf(NTCF_ASOFF + 1), 1e-6);
    } else {
        float m = 0.0;
        if (0 < inn) m = max(m, abs(ntcf_x[0]));
        if (1 < inn) m = max(m, abs(ntcf_x[1]));
        if (2 < inn) m = max(m, abs(ntcf_x[2]));
        if (3 < inn) m = max(m, abs(ntcf_x[3]));
