    const int ng = NTCF_NG3;
    const int gd = gs == 0 ? 1 : gs;
    const int in4 = (inn + 3) >> 2;
    const int in8 = (inn + 7) >> 3;
    const int in16 = (inn + 15) >> 4;
    const bool last = NTCF_LAYERS == 4;
    for (int o = 0; o < outn; o += 4) {
        const int wb = (NTCF_WO3 >> 2) + o * in4;
        vec4 bias = uintBitsToFloat(ntcf_p[(NTCF_BO3 >> 2) + (o >> 2)]);
        float r0 = bias[0]; float r1 = bias[1]; float r2 = bias[2]; float r3 = bias[3];
        float a0 = 0.0; float a1 = 0.0; float a2 = 0.0; float a3 = 0.0;
        uvec4 w;
        if (0 < inn) {
            w = ntcf_p[wb + 0 * in4 + 0];
            if (0 < inn && 0 / gd < ng) { a0 = ntcf_mad(a0, uintBitsToFloat(w[0]), ntcf_x[0]); if (1 == inn || 1 % gd == 0) { r0 = ntcf_sadd(r0, ntcf_pf(NTCF_SO3 + (o + 0) * ng + 0 / gd), a0); a0 = 0.0; } }
            if (1 < inn && 1 / gd < ng) { a0 = ntcf_mad(a0, uintBitsToFloat(w[1]), ntcf_x[1]); if (2 == inn || 2 % gd == 0) { r0 = ntcf_sadd(r0, ntcf_pf(NTCF_SO3 + (o + 0) * ng + 1 / gd), a0); a0 = 0.0; } }
            if (2 < inn && 2 / gd < ng) { a0 = ntcf_mad(a0, uintBitsToFloat(w[2]), ntcf_x[2]); if (3 == inn || 3 % gd == 0) { r0 = ntcf_sadd(r0, ntcf_pf(NTCF_SO3 + (o + 0) * ng + 2 / gd), a0); a0 = 0.0; } }
            if (3 < inn && 3 / gd < ng) { a0 = ntcf_mad(a0, uintBitsToFloat(w[3]), ntcf_x[3]); if (4 == inn || 4 % gd == 0) { r0 = ntcf_sadd(r0, ntcf_pf(NTCF_SO3 + (o + 0) * ng + 3 / gd), a0); a0 = 0.0; } }
            w = ntcf_p[wb + 1 * in4 + 0];
