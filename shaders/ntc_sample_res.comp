#version 450
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8, local_size_z = 1) in;
#include "ntc_decode.glsl"

// g_pc.z / g_pc.w are the output width and height. uv covers that rectangle.
void main() {
    uint W = g_pc.z;
    uint H = g_pc.w;
    if (W == 0u || H == 0u) return;
    if (gl_GlobalInvocationID.x >= W || gl_GlobalInvocationID.y >= H) return;
    vec2 uv = (vec2(gl_GlobalInvocationID.xy) + vec2(0.5)) / vec2(float(W), float(H));
    ntc_eval(uv, int(g_pc.x));
    uint ch = g_desc[0].z;
    uint idx = (gl_GlobalInvocationID.y * W + gl_GlobalInvocationID.x) * ch;
    for (uint i = 0u; i < ch; ++i) g_outimg[idx + i] = g_y[i];
}
